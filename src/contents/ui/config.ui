            </item>

            <item>
                <layout class="QFormLayout" name="formLayout_3">
                    <item row="0" column="0">
                        <widget class="QLabel"><property name="text"><string>Double-tap threshold:</string></property></widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QSpinBox" name="kcfg_doubleTapThresholdMs">
                            <property name="minimum"><number>150</number></property>
                            <property name="maximum"><number>800</number></property>
                            <property name="suffix"><string> ms</string></property>
                        </widget>
