<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>Config</class>
    <widget class="QWidget" name="Config">
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>0</y>
                <width>520</width>
                <height>800</height>
            </rect>
        </property>
        <layout class="QVBoxLayout" name="verticalLayout">

            <!-- Warning label -->
            <item>
                <widget class="QLabel">
                    <property name="text">
                        <string>After changing any setting, you must &lt;b&gt;disable and then re-enable&lt;/b&gt; the script&lt;br&gt;for the new values to take effect.</string>
                    </property>
                    <property name="wordWrap"><bool>true</bool></property>
                    <property name="alignment"><set>Qt::AlignCenter</set></property>
                    <property name="styleSheet">
                        <string>QLabel { color: #d32f2f; font-weight: bold; background: #ffebee; padding: 8px; border-radius: 4px; }</string>
                    </property>
                </widget>
            </item>
            <!-- Startup/new desktop defaults (Ctrl+Shift+F1..F4) -->
            <item>
                <widget class="QLabel">
                    <property name="text">
                        <string>&lt;b&gt;Default startup/new desktop modes:&lt;/b&gt;</string>
                    </property>
                </widget>
            </item>
            <item>
                <layout class="QFormLayout">
                    <item row="0" column="0">
                        <widget class="QLabel">
                            <property name="text">
                                <string> mode:</string>
                            </property>
                        </widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QComboBox" name="kcfg_defaultDesktopMode">
                            <item><property name="text"><string>Tiled mode</string></property></item>
                            <item><property name="text"><string>KWin tiling mode</string></property></item>
                            <item><property name="text"><string>Float all windows</string></property></item>
                            <item><property name="text"><string>Maximize all windows</string></property></item>
                        </widget>
                    </item>
                </layout>
            </item>
            <item>
                <layout class="QFormLayout">
                    <item row="0" column="0">
                        <widget class="QLabel">
                            <property name="text">
                                <string> ratio preset:</string>
                            </property>
                        </widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QComboBox" name="kcfg_defaultPresetIndex">
                            <property name="currentIndex"><number>0</number></property>
                            <item><property name="text"><string>0 – 1.5 : 1.5</string></property></item>
                            <item><property name="text"><string>1 – 2.0 : 2.0</string></property></item>
                            <item><property name="text"><string>2 – 3.0 : 3.0</string></property></item>
                            <item><property name="text"><string>3 – 1.0 : 1.0</string></property></item>
                        </widget>
                    </item>
                </layout>
            </item>
            <item>
                <layout class="QFormLayout">
                    <item row="0" column="0">
                        <widget class="QLabel">
                            <property name="text">
                                <string> auto-retile mode:</string>
                            </property>
                        </widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QComboBox" name="kcfg_autoRetileMode">
                            <item><property name="text"><string>Off (disabled)</string></property></item>
                            <item><property name="text"><string>Tiled only (skip if maximized)</string></property></item>
                            <item><property name="text"><string>Always (force retile)</string></property></item>
                        </widget>
                    </item>
                </layout>
            </item>

            <!-- window decorations -->
            <item>
                <layout class="QFormLayout">
                    <item row="0" column="0">
                        <widget class="QLabel">
                            <property name="text">
                                <string> decorations mode:</string>
                            </property>
                        </widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QComboBox" name="kcfg_decorationMode">
                            <item><property name="text"><string>Tiled: no decorations / Floating: decorations</string></property></item>
                            <item><property name="text"><string>All windows have decorations</string></property></item>
                            <item><property name="text"><string>No decorations at all</string></property></item>
                        </widget>
                    </item>
                </layout>
            </item>
            <item>
                <widget class="QCheckBox" name="kcfg_ignoreTransientWindows">
                    <property name="text">
                        <string>Ignore dialogs (transient windows)</string>
                    </property>
                    <property name="toolTip">
                        <string>If enabled, dialog and transient windows will not be tiled or affect layout.</string>
                    </property>
                    <property name="checked">
                        <bool>true</bool>
                    </property>
                </widget>
            </item>

            <!-- tileEvenIfNewMaximized -->
            <item>
                <widget class="QCheckBox" name="kcfg_tileEvenIfNewMaximized">
                    <property name="text">
                        <string>Tile new maximized windows</string>
                    </property>
                    <property name="toolTip">
                        <string>If enabled, newly opened windows will be tiled even if they start maximized.

                            Only applies in "tiled-only" mode.
                            In "always" mode, this setting has no effect.</string>
                    </property>
                </widget>
            </item>

            <!-- Maximum tiled windows -->
            <item>
                <layout class="QFormLayout">
                    <item row="0" column="0">
                        <widget class="QLabel">
                            <property name="text">
                                <string>Maximum tiled windows:</string>
                            </property>
                        </widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QSpinBox" name="kcfg_maxWindows">
                            <property name="minimum"><number>1</number></property>
                            <property name="maximum"><number>30</number></property>
                            <property name="value"><number>5</number></property>
                        </widget>
                    </item>
                </layout>
            </item>
            <!-- Overflow behavior -->
            <item>
                <layout class="QFormLayout">
                    <item row="0" column="0">
                        <widget class="QLabel">
                            <property name="text">
                                <string>When windows exceed limit:</string>
                            </property>
                        </widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QComboBox" name="kcfg_overflowBehavior">
                            <item><property name="text"><string>Keep floating</string></property></item>
                            <item><property name="text"><string>Smart move to least busy desktop (or next available/new)</string></property></item>
                            <item><property name="text"><string>Smart move to least busy desktop (forward only)</string></property></item>
                            <item><property name="text"><string>Move to empty desktop (or create new)</string></property></item>
                        </widget>
                    </item>
                </layout>
            </item>
            <item>
                <widget class="QCheckBox" name="kcfg_autoRemoveEmptyDesktops">
                    <property name="text">
                        <string>Remove empty desktops created by script</string>
                    </property>
                    <property name="checked">
                        <bool>true</bool>
                    </property>
                </widget>
            </item>
            <item>
                <spacer name="smallSpacer1">
                    <property name="orientation"><enum>Qt::Vertical</enum></property>
                    <property name="sizeType"><enum>QSizePolicy::Fixed</enum></property>
                    <property name="sizeHint" stdset="0">
                        <size><width>20</width><height>12</height></size>
                    </property>
                </spacer>
            </item>
            <item>
                <widget class="QCheckBox" name="kcfg_minimizeSnapshotOverflow">
                    <property name="text">
                        <string>Minimize windows exceeding layout after restore from snapshot</string>
                    </property>
                    <property name="toolTip">
                        <string>If enabled, windows that exceed the maximum layout after restoring from snapshot will be minimized.</string>
                    </property>
                </widget>
            </item>

            <!-- Auto-retile triggers -->
            <item>
                <widget class="QLabel">
                    <property name="text">
                        <string>&lt;b&gt;Auto-retile triggers&lt;/b&gt;</string>
                    </property>
                </widget>
            </item>

            <item>
                <layout class="QGridLayout">

                    <!-- ROW 0 -->
                    <item row="0" column="0">
                        <widget class="QCheckBox" name="kcfg_autoLayoutOnNewWindow">
                            <property name="text"><string>on new window</string></property>
                        </widget>
                    </item>

                    <item row="0" column="1">
                        <widget class="QCheckBox" name="kcfg_autoLayoutOnWindowClose">
                            <property name="text"><string>after closing window</string></property>
                        </widget>
                    </item>

                    <item row="0" column="2">
                        <widget class="QCheckBox" name="kcfg_autoLayoutOnWindowMinimize">
                            <property name="text"><string>after minimize</string></property>
                        </widget>
                    </item>

                    <!-- ROW 1 -->
                    <item row="1" column="0">
                        <widget class="QCheckBox" name="kcfg_autoLayoutOnWindowRestore">
                            <property name="text"><string>after restore</string></property>
                        </widget>
                    </item>

                    <item row="1" column="1">
                        <widget class="QCheckBox" name="kcfg_autoLayoutOnDesktopChange">
                            <property name="text"><string>on desktop switch</string></property>
                        </widget>
                    </item>

                    <item row="1" column="2">
                        <widget class="QCheckBox" name="kcfg_autoLayoutOnActivityChange">
                            <property name="text"><string>after activity switch</string></property>
                            <property name="checked"><bool>true</bool></property>
                        </widget>
                    </item>



                </layout>
            </item>

            <item>
                <spacer name="smallSpacer2">
                    <property name="orientation"><enum>Qt::Vertical</enum></property>
                    <property name="sizeType"><enum>QSizePolicy::Fixed</enum></property>
                    <property name="sizeHint" stdset="0">
                        <size><width>20</width><height>12</height></size>
                    </property>
                </spacer>
            </item>
            <!-- Ignore by title words -->
            <item>
                <widget class="QLabel">
                    <property name="text">
                        <string>&lt;b&gt;Ignore windows from tiling&lt;/b&gt; (comma separated; matches title, resourceClass (WM_CLASS), and resourceName)</string>
                    </property>
                </widget>
            </item>
            <item>
                <layout class="QVBoxLayout">
                    <item><widget class="QLineEdit" name="kcfg_ignoreWordsTiling1"/></item>
                </layout>
            </item>
            <item>
                <widget class="QCheckBox" name="kcfg_minimizeIgnoredWindows">
                    <property name="text">
                        <string>Minimize ignored windows</string>
                    </property>
                    <property name="toolTip">
                        <string>If enabled, ignored windows are minimized. If disabled, they remain visible and are not affected.</string>
                    </property>
                </widget>
            </item>
            <item>
                <widget class="QLabel">
                    <property name="text">
                        <string>&lt;b&gt;Ignore windows from cycling (Ctrl+Esc)&lt;/b&gt; (comma separated; matches title, resourceClass (WM_CLASS), and resourceName)</string>
                    </property>
                </widget>
            </item>
            <item>
                <layout class="QVBoxLayout">
                    <item><widget class="QLineEdit" name="kcfg_ignoreWordsCycling1"/></item>
                </layout>
            </item>

            <!-- Layout appearance -->

            <item>
                <layout class="QFormLayout">
                    <item row="0" column="0">
                        <widget class="QLabel">
                            <property name="text">
                                <string>Spacing:</string>
                            </property>
                        </widget>
                    </item>

                    <item row="0" column="1">
                        <layout class="QHBoxLayout">

                            <item>
                                <widget class="QLabel">
                                    <property name="text">
                                        <string>windows</string>
                                    </property>
                                </widget>
                            </item>

                            <item>
                                <widget class="QSpinBox" name="kcfg_gapBetweenWindows">
                                    <property name="minimum"><number>0</number></property>
                                    <property name="maximum"><number>64</number></property>
                                    <property name="suffix"><string> px</string></property>
                                </widget>
                            </item>

                            <item>
                                <widget class="QLabel">
                                    <property name="text">
                                        <string>screen</string>
                                    </property>
                                </widget>
                            </item>

                            <item>
                                <widget class="QSpinBox" name="kcfg_screenMargin">
                                    <property name="minimum"><number>0</number></property>
                                    <property name="maximum"><number>80</number></property>
                                    <property name="suffix"><string> px</string></property>
                                </widget>
                            </item>

                        </layout>
                    </item>
                </layout>
            </item>

            <!-- Other settings -->
            <item>
                <widget class="QLabel">
                    <property name="text">
                        <string>&lt;b&gt;Other settings&lt;/b&gt;</string>
                    </property>
